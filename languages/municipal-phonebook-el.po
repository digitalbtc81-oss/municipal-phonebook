#: includes/class-munipb-admin.php:444
msgid "Analytics"
msgstr "Στατιστικά"

#: includes/class-munipb-admin.php:444
msgid ""
"Send a \"click_to_call\" event to Google Analytics (gtag) when a phone link "
"is clicked."
msgstr ""
"Αποστολή συμβάντος «click_to_call» στο Google Analytics (gtag) όταν πατιέται "
"ένα τηλέφωνο."

#: includes/class-munipb-admin.php:445
